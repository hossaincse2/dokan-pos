# API Configuration
# Change this to your API server URL before building
API_BASE_URL=https://admin.karbar.shop
VITE_APP_ENV=development

# Store Configuration
VITE_DEFAULT_STORE_ID=1
VITE_PER_PAGE=12

# Sync Configuration
VITE_AUTO_SYNC_ENABLED=true
VITE_SYNC_INTERVAL_MINUTES=5

# Database Configuration
DB_PATH=./data/pos.db

# Security
# Generate a secure encryption key for production
ENCRYPTION_KEY=your-secure-encryption-key-here

# Logging
LOG_LEVEL=info
LOG_TO_FILE=true

# Receipt Configuration
RECEIPT_COMPANY_NAME=Your Company Name
RECEIPT_COMPANY_ADDRESS=Your Company Address
RECEIPT_COMPANY_PHONE=+880-XXX-XXXXXX
RECEIPT_TAX_RATE=0.15
