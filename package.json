{
  "name": "karbar-pos",
  "version": "2.0.0",
  "description": "Offline-first POS application built with Electron, React, and SQLite",
  "main": "main.js",
  "author": "Your Company",
  "license": "MIT",
  "scripts": {
    "dev": "npm run build:main && concurrently \"npm run dev:renderer\" \"npm run dev:electron\"",
    "dev:renderer": "node --max-old-space-size=4096 ./node_modules/vite/bin/vite.js --port 5173 --strictPort",
    "dev:electron": "wait-on http://localhost:5173 && set NODE_ENV=development&& electron . --no-sandbox",
    "dev:main": "node ./node_modules/typescript/bin/tsc -p tsconfig.main.json --watch",
    "build": "npm run build:renderer && npm run build:main",
    "build:renderer": "node ./node_modules/vite/bin/vite.js build",
    "build:main": "node ./node_modules/typescript/bin/tsc -p tsconfig.main.json",
    "build:karbar": "node build-for-client.js karbar",
    "build:megastar": "node build-for-client.js megastar",
    "build:custom": "node build-for-client.js custom",
    "start": "npm run build && electron .",
    "start:prod": "set NODE_ENV=production&& electron .",
    "package": "npm run build && node ./node_modules/electron-builder/cli.js",
    "package:win": "node scripts/prepare-package.js && npm run build && cross-env ELECTRON_BUILDER_BINARIES_MIRROR=https://mirrors.huaweicloud.com/electron-builder-binaries/ node ./node_modules/electron-builder/cli.js --win",
    "fix:build": "node scripts/fix-build-cache.js",
    "fix:native": "node scripts/fix-native-modules.js",
    "package:mac": "npm run build && node ./node_modules/electron-builder/cli.js --mac",
    "package:linux": "npm run build && node ./node_modules/electron-builder/cli.js --linux",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:e2e": "playwright test",
    "lint": "eslint src --ext .ts,.tsx",
    "format": "prettier --write \"src/**/*.{ts,tsx,json}\"",
    "clear-db": "node scripts/clear-and-sync.js",
    "clear-sync-queue": "node scripts/clear-sync-queue.js",
    "typecheck": "node ./node_modules/typescript/bin/tsc --noEmit",
    "db:reset": "node scripts/reset-db.js",
    "db:seed": "node scripts/seed-mock-data.js",
    "db:migrate": "node scripts/migrate-database.js",
    "db:add-salesman": "node scripts/add-salesman-id-column.js",
    "db:check-sync": "node scripts/check-sync-queue.js",
    "postinstall": "node scripts/ensure-electron.js && node ./node_modules/electron-builder/cli.js install-app-deps",
    "icon:check": "node scripts/generate-icon.js",
    "rebuild": "npx @electron/rebuild -f -w better-sqlite3"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.0.1",
    "axios": "^1.13.2",
    "better-sqlite3": "^12.11.1",
    "date-fns": "^3.0.6",
    "decimal.js": "^10.6.0",
    "electron-store": "^8.1.0",
    "jsbarcode": "^3.12.3",
    "knex": "^3.1.0",
    "mime-db": "^1.54.0",
    "qrcode": "^1.5.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-redux": "^9.0.4",
    "react-router-dom": "^6.21.1",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.1",
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^14.1.2",
    "@types/better-sqlite3": "^7.6.12",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.2.46",
    "@types/react-dom": "^18.2.18",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "@vitejs/plugin-react": "^4.2.1",
    "app-builder-bin": "^4.2.0",
    "autoprefixer": "^10.4.16",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^29.4.6",
    "electron-builder": "^24.13.3",
    "eslint": "^8.56.0",
    "eslint-plugin-react": "^7.33.2",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "postcss": "^8.4.32",
    "prettier": "^3.1.1",
    "tailwindcss": "^3.4.0",
    "ts-jest": "^29.1.1",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vite": "^5.0.10",
    "vite-plugin-electron": "^0.28.1",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.karbar.electronpos",
    "productName": "Karbar POS",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "dist/**/*",
      "main.js",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "publisherName": "Karbar Ecommerce"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Karbar POS",
      "deleteAppDataOnUninstall": true,
      "perMachine": false,
      "allowElevation": true,
      "runAfterFinish": true,
      "menuCategory": true,
      "include": "build/installer.nsh"
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}.${ext}"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "assets/icon.png",
      "category": "public.app-category.business"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "assets/icon.png",
      "category": "Office"
    }
  }
}
